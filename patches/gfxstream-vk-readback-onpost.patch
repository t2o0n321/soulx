+// SoulX: one onPost frame on a Vulkan-only host, read on the post thread into entry.img. Vulkan returns the
+// image as stored (no conversion), so R and B are swapped when the consumer wants the other order:
+// B,G,R,A when readBgra (the emulator's frame sharing behind -share-vid asks for it), else R,G,B,A.
+// False when the frame cannot be read this way (then nothing is posted and the previous frame stays).
+bool FrameBuffer::Impl::readbackVkFrame(uint32_t displayId, onPost& entry, ColorBuffer* cb) {
+    const uint32_t w = entry.width;
+    const uint32_t h = entry.height;
+    const size_t bytes = (size_t)w * h * 4;
+    const GfxstreamFormat format = cb->getFormat();
+    if (cb->getWidth() != w || cb->getHeight() != h ||
+        (format != GfxstreamFormat::R8G8B8A8_UNORM && format != GfxstreamFormat::B8G8R8A8_UNORM)) {
+        static std::atomic_bool sWarned{false};
+        if (!sWarned.exchange(true)) {
+            GFXSTREAM_ERROR("SoulX: cannot read back ColorBuffer %ux%u (format %d) for display %u (%ux%u)",
+                            cb->getWidth(), cb->getHeight(), (int)format, displayId, w, h);
+        }
+        return false;
+    }
+    std::lock_guard<std::mutex> guard(m_vkFramesLock);
+    cb->readToBytes(0, 0, (int)w, (int)h, format, entry.img, bytes);
+    if ((format == GfxstreamFormat::B8G8R8A8_UNORM) != entry.readBgra) {
+        for (unsigned char *p = entry.img, *end = entry.img + bytes; p < end; p += 4) {
+            std::swap(p[0], p[2]);
+        }
+    }
+    m_vkFrames[displayId] = {entry.img, bytes};
+    return true;
+}
+
+// SoulX: GetPixels on a Vulkan-only host: the frame readbackVkFrame read last (nothing before the first one).
+void FrameBuffer::Impl::copyVkFrame(uint32_t displayId, void* pixels, uint32_t bytes) {
+    std::lock_guard<std::mutex> guard(m_vkFramesLock);
+    const auto it = m_vkFrames.find(displayId);
+    if (it == m_vkFrames.end() || !pixels) return;
+    memcpy(pixels, it->second.first, std::min<size_t>(bytes, it->second.second));
+}
